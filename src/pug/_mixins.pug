          picture(class="img-tabs__pic")
            source(srcset data-load=srcseturl type=type)
            img(src="./images/preloader-green.svg" data-load=item.src alt=item.alt class="img-tabs__image")

        else 

          picture(class="img-tabs__pic")
            source(srcset=srcseturl type=type)
            img(src=item.src alt=item.alt class="img-tabs__image")

mixin stat(content, attr)

  - 
    content = content ?? {
      img: './images/icons/chef-icon.svg',
      alt: 'Chef',
      name: 'Professional Chefs',
      value: '420',
      //- mod: ''
    }

  div(class=`stat${content.mod ? content.mod : ''}` data-dig-anim="main")&attributes(attr)

    img(src=content.img alt=content.alt class="stat__icon")
    strong(class="stat__name logo-text")= content.name
    span(class="stat__value stat-text" data-dig-anim="increase")= content.value

mixin menu-item(content, attr)

  - 
    content = content ?? {
      img: './images/illustrations/menu-hamburger-preview.jpg',
      name: 'Hamburger',
      text: 'Big hamburger with meat, cheese and oil.',
      price: '14.5$',
      full: './images/illustrations/menu-hamburger.jpg',
    }

  article(class="menu-item")&attributes(attr)

    img(src="./images/preloader-green.svg" data-load=content.img alt=content.name class="menu-item__icon")
    h2(class="menu-item__name slide-text")= content.name
    em(class="menu-item__text mini-text")= content.text
    em(class="menu-item__price list-text")= content.price

mixin chef(content, attr)

  -
    content = content ?? {

      src: './images/illustrations/chef1.jpg',
      srcset: './images/illustrations/chef1.webp',
      name: 'D.Estwood',
      job: 'Chief Chef',
      lazy: true,

    }

  div(class="chef")&attributes(attr)

    - let srcset = content.srcset ?? scontent.src;
    - let type = content.srcset ? 'image/webp' : null;

    if content.lazy

      picture(class="chef__pic")
        source(srcset data-load=srcset type=type)
        img(src="./images/preloader-green.svg" data-load=content.src alt=content.name class="chef__image")

    else 

      picture(class="chef__pic")
        source(srcset=srcset type=type)
        img(src=content.src alt=content.name class="chef__image")

    div(class="chef__info")

      strong(class="chef__name list-text")= content.name
      em(class="chef__job mini-text")= content.job

mixin outline-btn(content, attr)

  if content !== null && typeof content === 'object'

    - 
      content = content ?? {
        url: './404.html',
        target: '_blank',
        text: 'See More',
      }

    a(href=content.url target=content.target class="outline-btn menu-text")&attributes(attr)= content.text

  else 

    - content = content ?? 'See More';

    button(class="outline-btn menu-text")&attributes(attr)= content 

mixin testim-slider(slides, attr)

  -
    slides = slides ?? [

      {
        avSRC: './images/illustrations/testimon1.jpg',
        avSRCSET: './images/illustrations/testimon1.webp',
        lazy: true,
        text: 'I had an amazing experience at this restaurant! The cozy atmosphere, friendly staff, and delicious food made my evening unforgettable. I ordered the grilled salmon, which was perfectly cooked and full of flavor. The dessert menu is also worth trying. Service was fast and attentive throughout. Great value for money. Highly recommended for a date night or dinner with friends. I’ll definitely be coming back again soon!',
        stars: [4, 5], //- n, max
        name: 'Alamin Hasan',
        job: 'Food Specialist',
      },

    ]

  div(class="testim-slider swiper")&attributes(attr)
    div(class="swiper-wrapper")

      each item, index in slides 

        div(class="swiper-slide")

          div(class="testim-slider__slide" data-load-bg="./images/backgrounds/flowers-bg.png")

            - let srcset = item.avSRCSET ?? avSRC;
            - let type = item.avSRCSET ? 'image/webp' : null;

            if item.lazy

              picture
                source(srcset data-load=srcset type=type)
                img(src="./images/preloader-green.svg" data-load=item.avSRC alt=item.name class="testim-slider__avatar")

            else 

              picture
                source(srcset=srcset type=type)
                img(src=item.avSRC alt=item.name class="testim-slider__avatar")

            img(src="./images/icons/quotes.svg" class="testim-slider__quotes")

            strong(class="testim-slider__text tes-text")= item.text

            div(class="testim-slider__info")

              +stars(item.stars[0], item.stars[1], { class: 'testim-slider__stars' })

              em(class="testim-slider__name logo-text")= item.name
              span(class="testim-slider__job job-text")= item.job

    div(class="swiper-pagination testim-slider__pagination")

mixin video-btn(text, attr)

  - text = text ?? 'Play Video';

  button(class="video-btn")&attributes(attr)

    span(class="video-btn__icon-wrapper")
      img(src="./images/icons/play-icon.svg" class="video-btn__icon")

    span(class="video-btn__text menu-text")= text












mixin stars(n, max, attr)

  - n = n ?? 5;
  - max = max ?? 5;

  div(class="stars")&attributes(attr)

    - for (let i = 1; i <= max; i++ )

      if i <= n

        img(src="./images/icons/star.svg" class="stars__icon")

      else 

        img(src="./images/icons/star-empty.svg" class="stars__icon")



mixin logotype(attr)

  a(href="./index.html" class="logotype logo-text")&attributes(attr)
    span(class="logotype__left") Food 
    span(class="logotype__right") tuck