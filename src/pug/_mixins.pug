mixin stars(n, max, attr)

  - n = n ?? 5;
  - max = max ?? 5;

  div(class="stars")&attributes(attr)

    - for (let i = 1; i <= max; i++ )

      if i <= n

        img(src="./images/icons/star.svg" alt="★" class="stars__icon")

      else 

        img(src="./images/icons/star-empty.svg" alt="✰" class="stars__icon")

