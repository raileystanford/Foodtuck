mixin share-btn(links, attr) 

  -
    links = links ?? [

      { icon: './images/sprite.svg#facebook', url: 'https://www.facebook.com' },
      { icon: './images/sprite.svg#pinterest', url: 'https://ru.pinterest.com' },
      { icon: './images/sprite.svg#twitter', url: 'https://x.com' },
      { icon: './images/sprite.svg#youtube', url: 'https://www.youtube.com' },
      { icon: './images/sprite.svg#whatsapp', url: 'https://www.whatsapp.com' },
