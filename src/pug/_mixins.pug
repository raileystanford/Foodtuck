mixin ad-block(content, attr)

  -
    content = content ?? {
      link: { url: './404.html', target: '_blank' },
      text: 'Perfect Taste',
      title: 'Classic Restaurant',
      price: '45.00',
      bg: {
        src: './images/illustrations/shop-now.jpg',
        srcset: './images/illustrations/shop-now.webp',
        lazy: true,
      },
    }

  a(class="ad-block" href=content.link.url target=content.link.target)&attributes(attr)

    em(class="ad-block__text menu-text")= content.text 
    strong(class="ad-block__title check-text")= content.title
    span(class="ad-block__price menu-text")= content.price

    - let srcseturl = content.bg.srcset ?? content.bg.src;
    - let type = content.bg.srcset ? 'image/webp' : null;

    if content.bg.lazy

      picture
        source(srcset="./images/preloader-green.svg" data-load=srcseturl type=type)
        img(src="./images/preloader-green.svg" data-load=content.bg.src alt=content.title class="ad-block__image")

    else 

      picture
        source(srcset=srcseturl type=type)
        img(src=content.bg.src alt=content.title class="ad-block__image")

    span(class="ad-block__bot-text menu-text") 
      span Shop Now
      svg(class="ad-block__icon")
        use(xlink:href="./images/sprite.svg#circle-arrow")

