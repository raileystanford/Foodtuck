mixin product-card(content, attr)

  -
    content = content ?? {

      img: { 
        src: './images/illustrations/shop-item1.jpg',
        srcset: './images/illustrations/shop-item1.webp',
        lazy: true,
      },

      id: 'product_1',
      name: 'Fresh Lime',
      url: './404.html',
      price: '38.00',
      oldPrice: '45.00',

      tags: [ { text: 'Sale', class: 'product-card__tag--sale' } ]

    }

  div(class="product-card" id=content.id)&attributes(attr)

    div(class="product-card__wrapper" data-load-block=content.img.lazy)

      - let srcseturl = content.img.srcset ?? content.img.src;
      - let type = content.img.srcset ? 'image/webp' : null;

      if content.img.lazy

        picture
          source(srcset="./images/preloader-green.svg" data-load=srcseturl type=type)
          img(src="./images/preloader-green.svg" data-load=content.img.src alt=content.name class="product-card__image")

      else 

        picture
          source(srcset=srcseturl type=type)
          img(src=content.img.src alt=content.name class="product-card__image")

      if content.tags

        div(class="product-card__tags")

          each item, index in content.tags 

            span(class=`product-card__tag ${item.class} menu-text`)=item.text

      div(class="product-card__controls")

        button(class="product-card__btn product-card__btn--compare")
          svg(class="product-card__btn-icon")
            use(xlink:href="./images/sprite.svg#compare")

        a(class="product-card__btn" href="./404.html" target="_blank")
          svg(class="product-card__btn-icon")
            use(xlink:href="./images/sprite.svg#cart")

        button(class="product-card__btn product-card__btn--like")
          svg(class="product-card__btn-icon")
            use(xlink:href="./images/sprite.svg#heart")

    a(class="product-card__footer" href=content.url target="_blank")

      strong(class="product-card__name list-text")= content.name 

      span(class="product-card__prices menu-text")

        span(class="product-card__price")= content.price 

        if content.oldPrice

          span(class="product-card__old-price")= content.oldPrice

mixin pagination(n, attr)

