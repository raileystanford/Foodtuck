article(class="demo-menu" data-title="menu")

  +heading(
    {
      title2: 'Choose & pick',
      sub: '<span class="heading__cl">Fr</span>om Our Menu',
    },
    { class: 'demo-menu__heading' }
  )

  div(class="menu-tabs")

    div(class="menu-tabs__controls")

      each item, index in demoMenuTabs

        button(class="menu-tabs__button slide-text" data-trig=item.tabName)= item.trigger 

    div(class="menu-tabs__content")

      each item, index in demoMenuTabs
    
        div(class="menu-tabs__tab" data-load-block data-tab=item.tabName)

          img(src="./images/preloader-green.svg" alt="Food" class="menu-tabs__big-img")

          each menuItem, index in item.items

            +menu-item(menuItem, 
              { 
                class: 'menu-tabs__menu-item',
                'data-full': menuItem.full,
                'data-link': menuItem.link,
              }
            )