article(class="chefs" data-title="chefs")

  +heading(
    {
      title2: 'Chefs',
      sub: '<span class="heading__cl">Me</span>et Our Chef',
    },
    { class: 'chefs__heading' }
  )

  div(class="chefs__content" data-show="show1")

    each item, index in chefsEmployee 

      +chef(item, { class: 'chefs__chef', 'data-load-block': '', 'data-link': item.link })

  +outline-btn(null, { class: 'chefs__outline-btn', 'data-show-trig': 'show1' })