include ./_mixins.pug

doctype html
html(lang="en")

  head

    block title
      title Foodtuck

    block meta-tags
      meta(charset="UTF-8")
      meta(name="viewport", content="width=device-width, initial-scale=1.0")

    block fav-icons
      link(rel="icon" href="./favicon.ico" type="image/x-icon" sizes="any")
      link(rel="icon" href="./images/favicon.png" type="image/png" sizes="64x64")

    block styles-libs

    block common-styles 
      link(rel="stylesheet" href="./css/desktop-states.css" media="(min-width: 769px)")
      link(rel="stylesheet" href="./css/mobile-states.css" media="(max-width: 768px)")

    block styles

    block scripts-libs

    block common-scripts 
      script(src="./js/common.js" type="module")

    block scripts

  body

    include ./blocks/_mob-navbar.pug
    include ./blocks/_mob-menu.pug

    div(class="page-wrapper")

      header(class="header")

        include ./blocks/_header-nav.pug

        block header-content

      main(class="main")

        block main-content

      footer(class="footer")

        include ./blocks/_footer-nav.pug

        block footer-content
        //- div(style="height: 1000px")

    include ./blocks/_scroll-top-btn.pug