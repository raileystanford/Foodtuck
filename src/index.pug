extends ./pug/_layout.pug

block title
  title Foodtuck - Home

block styles-libs
  link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css")

block styles 
  link(rel="stylesheet" href="./css/index.css")

block scripts-libs 

  script.

    let media = window.matchMedia('(max-width: 768px)').matches;

    if (!media) {

      let block = document.createElement('div');
      block.style.cssText = 'position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 100; background: black;';
      document.head.after(block);

      window.addEventListener('load', (event) => block.remove());

    } 
    
  script(src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js" defer)
  script(src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollSmoother.min.js" defer)
  script(src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js" defer)
  script(src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js" defer)

block scripts 
  script(src="./js/index.js" type="module")

block header-content 

  include ./pug/blocks/_index-intro.pug

block main-content 

  include ./pug/blocks/_index-about.pug
  include ./pug/blocks/_food-cat.pug
  include ./pug/blocks/_choose-us.pug
  include ./pug/blocks/_stats.pug
  include ./pug/blocks/_demo-menu.pug
  include ./pug/blocks/_chefs.pug
  include ./pug/blocks/_testimonials.pug
  include ./pug/blocks/_process.pug
  include ./pug/blocks/_blogpost.pug