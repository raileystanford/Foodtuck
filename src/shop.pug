  div(class="market" data-title="market")

    div(class="market__head")

      button(class="market__filters-trig slide-text") Filters

      +custom-select(null, null, { class: 'market__custom-select market__custom-select--sortBy' })
      +custom-select('Show:', showSelectVars, { class: 'market__custom-select market__custom-select--show' })

    div(class="market__selected-filters")

    div(class="market__goods-content")

      each item, index in goods

        +product-card(item, { class: 'market__product-card' })

    form(class="market__sidebar" action="#" method="post" novalidate data-form)

      +shop-search(null, { class: 'market__shop-search' })

      div(class="market__panel")

        span(class="market__panel-name check-text") Category

        +check-list(null, null, { class: 'market__check-list' })
        +ad-block(null, { class: "market__ad-block", 'data-load-block': '' })

      div(class="market__panel")

        span(class="market__panel-name check-text") Filter By Price

        +custom-range(null, { class: 'market__custom-range' })

      div(class="market__panel")

        span(class="market__panel-name check-text") Latest Products

        each item, index in suggestions

          +suggestion(item, { class: 'market__suggestion' })

      div(class="market__panel")

        span(class="market__panel-name check-text") Product Tags

        +tags-check()

    +pagination(null, { class: 'market__pagination' })